{
    "comments": {
        // 行注释
        "lineComment": "//",
        // 块注释（NDF 同时支持 /* */ 与 (* *)，VS Code 只能声明一对方括号）
        "blockComment": ["/*", "*/"]
    },
    // 括号对
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    // 输入时自动闭合
    "autoClosingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // 选区包裹
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // 标识符：字母/下划线开头（关键字与内建类型名都是标识符形态）
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
    "indentationRules": {
        "increaseIndentPattern": "\\(\\s*$|\\[\\s*$",
        "decreaseIndentPattern": "^\\s*[\\)\\]]"
    }
}
